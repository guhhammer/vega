<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the application's manifest by Gradle. That is the whole reason
  this plugin is a crate with its own Gradle project rather than an edit to
  `gen/android`: that directory is regenerated by `tauri android init` on every
  build, and anything written there is lost.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- mDNS receives nothing without the multicast lock this grants. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- A runtime prompt from API 33. Refusing it does not stop the service:
         Android shows a foreground service's notification either way. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only to open the system dialog. Holding the permission grants nothing;
         the user's answer does. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>

        <!--
          `specialUse`, not `dataSync`. From Android 15 a dataSync service is
          capped at six hours in any 24, after which the system calls
          onTimeout() and refuses to start another until the user opens the app
          — a messenger that goes deaf every afternoon. specialUse carries no
          timeout and no runtime prerequisites. Its <property> justification is
          read by Google Play reviewers, and there is no store listing here.

          stopWithTask=false: swiping the app out of recents is not a request to
          stop receiving mail. It is also the case that walks into
          tauri-apps/tauri#15671 — see the RunEvent handling in the app.
        -->
        <service
            android:name=".NodeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Peer-to-peer message delivery over a socket this app owns. There is no server to push from, so the process has to stay alive to receive anything." />
        </service>

    </application>

</manifest>
