/target
node_modules/
app/dist/
app/src-tauri/gen/

# Installers staged by `./make dist`. They are release artifacts, published to
# a GitHub Release by release.yml — never committed.
/release/

logs/

# Left behind by assets/logo/render.py. The PNGs it writes *are* committed —
# they are the logo — but its bytecode cache is not.
__pycache__/

# Android signing keys. There should never be one in the tree, and an accident
# with `keytool -keystore` in the wrong directory should not become a commit.
*.jks
*.keystore

.env
.env.*
!.env.example

*.swp
.DS_Store

# Cargo.lock is committed on purpose: this repo builds applications, not a
# library, and a reproducible dependency set is part of what a messenger's
# users are trusting.
